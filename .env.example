# ─── Application ─────────────────────────────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development

# Port the NestJS server listens on
PORT=3000

# Base URL for public QR links and deep-links redirect
APP_BASE_URL=https://studio-backend-5slu.onrender.com

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection URL (used by Prisma)
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB?schema=public

# Individual PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=studio_gallery

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT access tokens — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# JWT access token expiry (e.g., 1h, 3600s)
JWT_ACCESS_EXPIRY=1h

# Refresh token expiry (e.g., 30d)
JWT_REFRESH_EXPIRY=30d

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Your Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary API key (found in Cloudinary dashboard)
CLOUDINARY_API_KEY=your_api_key

# Cloudinary API secret — never expose this to the client
CLOUDINARY_API_SECRET=your_api_secret

# Signed URL expiry in seconds (default: 86400 = 24 hours)
CLOUDINARY_SIGNED_URL_EXPIRY=86400

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Firebase project ID (from Firebase console → Project Settings)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase service account client email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Firebase service account private key — replace newlines with \n in .env
# Copy the full private key from your Firebase service account JSON file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── App Store / Play Store URLs ─────────────────────────────────────────────
# iOS App Store URL for QR fallback redirect
APP_STORE_URL=https://apps.apple.com/app/id000000000

# Google Play Store URL for QR fallback redirect
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.studiogallery.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Time-to-live for rate limit window in milliseconds (default: 60000 = 1 minute)
THROTTLE_TTL=60000

# Maximum number of requests allowed per IP within the TTL window
THROTTLE_LIMIT=100

# ─── Development Only (never enable in production) ─────────────────────────────
# Generate OTP server-side and log to terminal (never returned in API response)
ENABLE_DEV_OTP=true

# Allow demo login bypass for seeded phone numbers (+911234567890, +919876543210)
ALLOW_DEMO_AUTH=true
